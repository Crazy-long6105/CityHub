# Docker 环境变量配置模板
# 复制此文件为 .env 并修改为实际值

# MySQL 配置
MYSQL_ROOT_PASSWORD=your_mysql_password_here

# Redis 配置
REDIS_PASSWORD=your_redis_password_here

# 后端应用配置
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_hmdp?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your_redis_password_here
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Stable and unique for every deployed backend instance.
HMDP_INSTANCE_ID=hmdp-backend-1
# At least 32 random bytes, identical on all instances. Do not commit the real secret.
HMDP_SECKILL_QUERY_SECRET=
# Enable only after incremental migrations and legacy order/control-data audit.
HMDP_SECKILL_ENABLED=false
HMDP_ORDER_LIFECYCLE_ENABLED=false
